mixin button($text, $link)
  a.button(href=$link)= $text

header 
  nav
    +button('Home', '/')
    +button('Rozgrywki', '/matches')
    +button('Statystyki', '/statistics')
    +button('Chat', '/chat')
  nav
    if user.loggedIn
      +button(user.username, '/profile')
      +button('Wyloguj', '/logout')
    else
      +button('Zaloguj', '/login')
      +button('Rejestracja', '/signup')