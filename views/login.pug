doctype html
html
  head
  include includes/head.pug
  script(src='/js/login.js')
    title= title
  body
    include includes/header.pug
    main.login-page.d-flex.align-items-center.justify-content-center.py-5
      .login-shell.container
        .row.justify-content-center
          .col-md-7.col-lg-5
            .card.login-card.shadow-lg
              .card-body.p-4.p-md-5
                h1.h3.mb-2.text-center Login
                p.text-center.text-muted.mb-4 Access your account to keep playing.
                if error
                  .alert.alert-danger(role='alert')= error
                form(action='/login', method='post', novalidate)
                  .mb-3
                    label.form-label(for='username') Username
                    input#username.form-control(type='text', name='username', required, autocomplete='username', placeholder='Your Username')
                  .mb-3
                    label.form-label(for='password') Password
                    input#password.form-control(type='password', name='password', required, autocomplete='current-password', placeholder='••••••••')
                  .d-flex.justify-content-between.align-items-center.mb-4
                    .form-check.mb-0
                      input#remember.form-check-input(type='checkbox', name='remember')
                      label.form-check-label(for='remember') Remember me
                    a(href='/signup').small.text-decoration-none Need an account?
                  button.btn.btn-primary.w-100(type='submit') Sign in
