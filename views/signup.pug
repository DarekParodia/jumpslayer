doctype html
html
  head
    include includes/head.pug
    script(src="/js/signup.js") 
    title= title
  body
    include includes/header.pug
    main.login-page.d-flex.align-items-center.justify-content-center.py-5
      .login-shell.container
        .row.justify-content-center
          .col-md-7.col-lg-5
            .card.login-card.shadow-lg
              .card-body.p-4.p-md-5
                h1.h3.mb-2.text-center Sign Up
                p.text-center.text-muted.mb-4 Create your account to start playing.
                if error
                  .alert.alert-danger(role='alert')= error
                form#signupForm(action='/signup', method='post', novalidate, class='needs-validation')
                  .mb-3
                    label.form-label(for='username') Username
                    // Username must be between 3 and 20 chars
                    input#username.form-control(type='text', name='username', required, autocomplete='username', placeholder='Your Username', minlength='3', maxlength='20')
                    .invalid-feedback Username must be between 3 and 20 characters.
                  .mb-3
                    label.form-label(for='password') Password
                    // Password must be between 3 and 20 chars
                    input#password.form-control(type='password', name='password', required, autocomplete='new-password', placeholder='Create a password', minlength='3', maxlength='20')
                    .invalid-feedback Password must be between 3 and 20 characters.
                  .mb-4
                    label.form-label(for='confirmPassword') Confirm password
                    input#confirmPassword.form-control(type='password', name='confirmPassword', required, autocomplete='new-password', placeholder='Repeat your password')
                    .invalid-feedback Passwords do not match.
                  .d-flex.justify-content-between.align-items-center.mb-4
                    a(href='/login').small.text-decoration-none Already have an account?
                  button.btn.btn-primary.w-100(type='submit') Create account

                //- Inline validation script removed; use external JS file instead
